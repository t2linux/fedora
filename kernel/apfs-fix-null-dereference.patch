From b34ab93f2ced41766f069e08937accd4d336a419 Mon Sep 17 00:00:00 2001
From: Ernesto A. Fernández <ernesto@corellium.com>
Date: Tue, 10 Nov 2026 20:35:06 +0000
Subject: [PATCH] Fix npd in previous untested patch

Upstream: https://github.com/linux-apfs/linux-apfs-rw/commit/b34ab93f2ced41766f069e08937accd4d336a419
Signed-off-by: Ernesto A. Fernández <ernesto@corellium.com>
---
 fs/apfs/inode.c | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/fs/apfs/inode.c b/fs/apfs/inode.c
--- a/fs/apfs/inode.c
+++ b/fs/apfs/inode.c
@@ -1034,8 +1034,6 @@ static int apfs_inode_trim_overallocation(struct inode *inode)
 
 	if (!S_ISREG(inode->i_mode))
 		return 0;
-	if (!ai->i_has_dstream)
-		return 0;
 
 	sb = inode->i_sb;
 	/* The overallocation issues we want to prevent only affect writes */
@@ -1050,6 +1048,8 @@ static int apfs_inode_trim_overallocation(struct inode *inode)
 	if (ai->i_bsd_flags & APFS_INOBSD_COMPRESSED)
 		return 0;
 
+	if (!ai->i_has_dstream)
+		return 0;
 	dstream = &ai->i_dstream;
 	if (dstream->ds_alloced_size == apfs_alloced_size(dstream)) {
 		/* No overallocation */
